# Copy to .env if you need to change something. XAMPP defaults: user root, empty password.
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=school_clinic_system
JWT_SECRET=change-this-to-any-long-random-text

# Extra browser addresses allowed to call the API (comma separated).
# Any http://localhost or http://127.0.0.1 address (any port) is always allowed.
CORS_ORIGINS=

# Patients may check themselves in this many minutes before their slot (0 = only nurses can check in)
SELF_CHECKIN_MINUTES_BEFORE=30
